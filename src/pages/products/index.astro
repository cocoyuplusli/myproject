---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categoryUrl, getCategories, getProducts } from '../../lib/content';

const categories = await getCategories();
const products = await getProducts();
const groups = categories
	.map((category) => ({ category, items: products.filter((p) => p.data.category.id === category.id) }))
	.filter((g) => g.items.length > 0);
---

<BaseLayout title="Products" description="Browse our full range of products and specifications.">
	<div class="container">
		<Breadcrumb items={[{ label: 'Products' }]} />
		<header class="page-head">
			<p class="eyebrow">Catalog</p>
			<h1>Products</h1>
			<p class="lead">Browse our full range of products and specifications.</p>
		</header>
		{
			groups.map(({ category, items }) => (
				<section class="group">
					<div class="section-head">
						<h2 class="section-title">
							<a href={categoryUrl(category.id)}>{category.data.name}</a>
						</h2>
						<a class="link-arrow" href={categoryUrl(category.id)}>
							View category
						</a>
					</div>
					<div class="grid">
						{items.map((p) => (
							<ProductCard product={p} />
						))}
					</div>
				</section>
			))
		}
	</div>
</BaseLayout>

<style>
	.group {
		padding-top: 64px;
	}
	.section-title a {
		color: inherit;
		text-decoration: none;
	}
	.section-title a:hover {
		color: var(--color-primary);
	}
</style>
