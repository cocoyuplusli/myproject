---
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Gallery from '../../components/Gallery.astro';
import SpecTable from '../../components/SpecTable.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import ProductCard from '../../components/ProductCard.astro';
import site from '../../data/site.json';
import { categoryUrl, getProducts } from '../../lib/content';

export const getStaticPaths = (async () => {
	const products = await getProducts();
	return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}) satisfies GetStaticPaths;

const { product } = Astro.props;
const { title, summary, images, specs } = product.data;
const category = await getEntry(product.data.category);
const { Content } = await render(product);
const related = (
	await getProducts((p) => p.data.category.id === product.data.category.id && p.id !== product.id)
).slice(0, 4);

const og = await getImage({ src: images[0], width: 1200, format: 'jpg' });
const ogImage = new URL(og.src, Astro.site).href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: title,
	description: summary,
	image: ogImage,
	category: category.data.name,
	brand: { '@type': 'Brand', name: site.shortName },
	additionalProperty: specs.map((s) => ({ '@type': 'PropertyValue', name: s.name, value: s.value })),
};
---

<BaseLayout title={title} description={summary} ogImage={ogImage}>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

	<div class="container">
		<Breadcrumb
			items={[
				{ label: 'Products', href: '/products/' },
				{ label: category.data.name, href: categoryUrl(category.id) },
				{ label: title },
			]}
		/>

		<div class="product">
			<Gallery images={images} alt={title} />
			<div class="product__info">
				<p class="eyebrow">{category.data.name}</p>
				<h1>{title}</h1>
				<p class="product__summary">{summary}</p>
				<h2 class="product__label">Specifications</h2>
				<SpecTable specs={specs} />
				<div class="product__actions">
					<a class="btn" href="#inquiry">Get a Quote</a>
					<WhatsAppButton text={`Hi, I'm interested in ${title}.`} />
				</div>
			</div>
		</div>

		<section class="block">
			<p class="eyebrow">Overview</p>
			<h2 class="section-title">Product Details</h2>
			<div class="prose"><Content /></div>
		</section>

		<section class="block inquiry">
			<div class="inquiry__intro">
				<p class="eyebrow">Inquiry</p>
				<h2 class="section-title">Send an Inquiry</h2>
				<p class="lead">
					Leave your requirements and we will reply within one business day. You can also email
					<a href={`mailto:${site.email}`}>{site.email}</a>.
				</p>
			</div>
			<InquiryForm product={title} />
		</section>

		{
			related.length > 0 && (
				<section class="block">
					<p class="eyebrow">More</p>
					<h2 class="section-title">Related Products</h2>
					<div class="grid">
						{related.map((p) => (
							<ProductCard product={p} />
						))}
					</div>
				</section>
			)
		}
	</div>
</BaseLayout>

<style>
	.product {
		display: grid;
		gap: 40px;
		grid-template-columns: minmax(0, 1fr);
		padding-bottom: 24px;
	}
	@media (min-width: 900px) {
		.product {
			grid-template-columns: minmax(0, 560px) minmax(0, 1fr);
			gap: 56px;
			align-items: start;
		}
	}
	.product__info h1 {
		margin: 0 0 16px;
	}
	.product__summary {
		margin: 0 0 32px;
		color: var(--color-muted);
		font-size: 1.0625rem;
	}
	.product__label {
		margin: 0 0 12px;
		color: var(--color-text);
		font-family: var(--font);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.product__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 32px;
	}
	/* 详情页各块之间用细线分隔 */
	.block {
		margin-top: calc(var(--section-space) * 0.75);
		padding-top: calc(var(--section-space) * 0.75);
		border-top: 1px solid var(--color-border);
	}
	.inquiry {
		display: grid;
		gap: 32px 72px;
		grid-template-columns: minmax(0, 1fr);
	}
	@media (min-width: 900px) {
		.inquiry {
			grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		}
	}
	.inquiry .lead {
		margin: 0;
	}
</style>
