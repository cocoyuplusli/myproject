---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import site from '../data/site.json';
import { categoryUrl, getCategories, getProducts } from '../lib/content';
import heroImage from '../assets/home/hero.jpg';

const featured = await getProducts((p) => p.data.featured);
const categories = await getCategories();
---

<BaseLayout>
  <section class="hero">
    <Image
      class="hero__bg"
      src={heroImage}
      alt=""
      widths={[960, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container hero__inner">
      <div class="hero__text">
        <h1>Night Vision and Thermals</h1>
        <p class="hero__tagline">For any occasion</p>
        <div class="hero__actions">
          <a class="btn btn--ghost" href="/products/">View Products</a>
          <a class="btn btn--ghost" href="/contact/">Contact Us</a>
        </div>
      </div>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">Products</p>
              <h2 class="section-title">Featured Products</h2>
            </div>
            <a class="link-arrow" href="/products/">
              All products
            </a>
          </div>
          <div class="grid">
            {featured.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Categories</p>
          <h2 class="section-title">Product Categories</h2>
        </div>
      </div>
      <div class="grid">
        {
          categories.map((c) => (
            <a class="category" href={categoryUrl(c.id)}>
              {c.data.cover && (
                <div class="category__media">
                  <Image
                    src={c.data.cover}
                    alt={c.data.name}
                    width={600}
                    height={400}
                  />
                </div>
              )}
              <div class="category__body">
                <span class="category__name">{c.data.name}</span>
                {c.data.description && (
                  <span class="category__desc">{c.data.description}</span>
                )}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about">
      <div>
        <p class="eyebrow">About Us</p>
        <h2 class="section-title">{site.name}</h2>
        <p class="lead">{site.about[0]}</p>
        <a class="btn btn--outline" href="/about/">Learn More</a>
      </div>
      <ul class="why">
        {site.highlights.map((h) => <li>{h}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* 满宽场景图横幅：人物在画面右侧，文字放左侧，左边加暗色渐变保证可读 */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 364px;
    overflow: hidden;
    /* 与原图背景色一致，图片左侧渐隐后看不出接缝 */
    background: #0f1012;
    color: #fff;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 20%;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, 0.6);
  }
  /* 宽屏：横幅高度随宽度变化，图片按高度完整显示并靠右，左侧渐隐留给文字 */
  @media (min-width: 900px) {
    .hero {
      height: clamp(364px, 30.8vw, 574px);
    }
    /* 元素尺寸 = 图片本身（16:10），遮罩才会落在图片真实的左边缘 */
    .hero__bg {
      left: auto;
      right: 0;
      width: auto;
      height: 100%;
      aspect-ratio: 16 / 10;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 35%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 35%);
    }
    .hero::before {
      background: linear-gradient(90deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.25) 40%, transparent 60%);
    }
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: 48px;
    padding-bottom: 48px;
  }
  .hero__text {
    max-width: 560px;
  }
  .hero h1 {
    margin: 0 0 14px;
    color: #fff;
    font-size: var(--fs-display);
    font-weight: 800;
    letter-spacing: 0.01em;
    line-height: 1.05;
    text-transform: uppercase;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.5);
  }
  .hero__tagline {
    margin: 0 0 36px;
    color: #d0d0d0;
    font-size: 1.125rem;
    font-style: italic;
    font-weight: 600;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  /* 参考图样式：白色细边框按钮，悬停反白 */
  .btn--ghost {
    border-color: #fff;
    background: transparent;
    color: #fff;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .btn--ghost:hover {
    border-color: #fff;
    background: #fff;
    color: #000;
  }

  .category {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 0.25s;
  }
  .category:hover {
    border-color: var(--color-primary);
  }
  .category__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }
  .category__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .category:hover .category__media img {
    transform: scale(1.04);
  }
  .category__body {
    display: grid;
    gap: 6px;
    padding: 20px 22px;
  }
  .category__name {
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .category__name::after {
    content: ' →';
    color: var(--color-primary);
  }
  .category__desc {
    color: var(--color-muted);
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .about {
    display: grid;
    gap: 48px;
    align-items: center;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 72px;
    }
  }
  .about .lead {
    margin: 0 0 32px;
  }
  .why {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 32px;
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-text);
    border-radius: var(--radius);
    background: var(--color-bg-soft);
    list-style: none;
  }
  .why li {
    position: relative;
    padding-left: 28px;
    font-weight: 500;
  }
  /* 对勾 */
  .why li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.45em;
    width: 12px;
    height: 7px;
    border-left: 2px solid var(--color-text);
    border-bottom: 2px solid var(--color-text);
    transform: rotate(-45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .category__media img {
      transition: none;
    }
    .category:hover .category__media img {
      transform: none;
    }
  }
</style>
