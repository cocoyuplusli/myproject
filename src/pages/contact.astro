---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import InquiryForm from '../components/InquiryForm.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import site from '../data/site.json';
---

<BaseLayout title="Contact Us" description={`Contact ${site.name} for quotations, samples and datasheets.`}>
	<div class="container">
		<Breadcrumb items={[{ label: 'Contact' }]} />
		<header class="page-head">
			<p class="eyebrow">Contact</p>
			<h1>Contact Us</h1>
			<p class="lead">Quotations, samples and datasheets — we usually reply within one business day.</p>
		</header>
		<div class="contact">
			<div class="contact__aside">
				<dl class="contact__info">
					<dt>Email</dt>
					<dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
					<dt>WhatsApp</dt>
					<dd>{site.whatsappDisplay}</dd>
				</dl>
				<WhatsAppButton text="Hi, I'd like to know more about your products." />
			</div>
			<div>
				<h2>Send us a message</h2>
				<InquiryForm />
			</div>
		</div>
	</div>
</BaseLayout>

<style>
	.contact {
		display: grid;
		gap: 48px 72px;
		grid-template-columns: minmax(0, 1fr);
		padding-top: 48px;
	}
	@media (min-width: 900px) {
		.contact {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
		}
	}
	.contact h2 {
		margin: 0 0 24px;
	}
	.contact__aside {
		padding: 32px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg-soft);
		align-self: start;
	}
	.contact__info {
		margin: 0 0 28px;
	}
	.contact__info dt {
		color: var(--color-muted);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.contact__info dd {
		margin: 4px 0 22px;
		color: var(--color-text);
		font-weight: 500;
	}
</style>
