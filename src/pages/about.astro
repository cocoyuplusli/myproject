---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import site from '../data/site.json';
---

<BaseLayout title="About Us" description={site.about[0]}>
	<div class="container">
		<Breadcrumb items={[{ label: 'About Us' }]} />
		<header class="page-head">
			<p class="eyebrow">About Us</p>
			<h1>About {site.name}</h1>
		</header>
		<div class="about">
			<div class="about__text">
				{site.about.map((p, i) => <p class={i === 0 ? 'lead' : undefined}>{p}</p>)}
				<p><a class="btn" href="/contact/">Contact Us</a></p>
			</div>
			<aside class="why">
				<h2 class="why__title">Why Choose Us</h2>
				<ul class="why__list">
					{site.highlights.map((h) => <li>{h}</li>)}
				</ul>
			</aside>
		</div>
	</div>
</BaseLayout>

<style>
	.about {
		display: grid;
		gap: 40px 72px;
		grid-template-columns: minmax(0, 1fr);
		padding-top: 48px;
	}
	@media (min-width: 900px) {
		.about {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			align-items: start;
		}
	}
	.about__text {
		color: #2a3440;
	}
	.about__text p:first-child {
		margin-top: 0;
		color: var(--color-text);
	}
	.about__text p:last-child {
		margin-top: 32px;
	}
	.why {
		padding: 32px;
		border: 1px solid var(--color-border);
		border-top: 2px solid var(--color-primary);
		border-radius: var(--radius);
		background: var(--color-bg-soft);
	}
	.why__title {
		margin: 0 0 20px;
		font-size: var(--fs-h3);
	}
	.why__list {
		display: grid;
		gap: 12px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.why__list li {
		position: relative;
		padding-left: 28px;
		color: var(--color-text);
		font-weight: 500;
	}
	/* 对勾 */
	.why__list li::before {
		content: '';
		position: absolute;
		left: 2px;
		top: 0.45em;
		width: 12px;
		height: 7px;
		border-left: 2px solid var(--color-primary);
		border-bottom: 2px solid var(--color-primary);
		transform: rotate(-45deg);
	}
</style>
