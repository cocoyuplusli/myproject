---
import site from '../data/site.json';
import { whatsappUrl } from '../lib/content';

const links = [
	{ href: '/products/', label: 'Products' },
	{ href: '/about/', label: 'About Us' },
	{ href: '/contact/', label: 'Contact' },
];
---

<footer class="footer">
	<div class="container footer__inner">
		<div class="footer__brand">
			<p class="footer__name">{site.shortName}</p>
			<p>{site.tagline}</p>
		</div>
		<div>
			<p class="footer__heading">Company</p>
			<ul class="footer__list">
				{
					links.map((l) => (
						<li>
							<a href={l.href}>{l.label}</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<p class="footer__heading">Contact</p>
			<ul class="footer__list">
				<li><a href={`mailto:${site.email}`}>{site.email}</a></li>
				<li>
					<a href={whatsappUrl()} target="_blank" rel="noopener">WhatsApp {site.whatsappDisplay}</a>
				</li>
			</ul>
		</div>
	</div>
	<div class="footer__bottom">
		<!-- 公司名已以 "Ltd." 结尾，后面不再加句号 -->
		<div class="container footer__copy">© {new Date().getFullYear()} {site.name} All rights reserved.</div>
	</div>
</footer>

<style>
	/* 配色与页头一致：主体黑底，底部版权条同顶部联系栏（#111） */
	.footer {
		margin-top: var(--section-space);
		padding-top: 64px;
		border-top: 1px solid #222;
		background: #000;
		color: #9a9a9a;
		font-size: var(--fs-small);
	}
	.footer a {
		color: #cfcfcf;
		text-decoration: none;
		transition: color 0.2s;
	}
	.footer a:hover {
		color: #fff;
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.footer__inner {
		display: grid;
		gap: 40px;
		grid-template-columns: minmax(0, 1fr);
	}
	@media (min-width: 760px) {
		.footer__inner {
			grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr) minmax(0, 1.2fr);
		}
	}
	.footer p {
		margin: 0;
	}
	.footer__brand p + p {
		max-width: 340px;
		margin-top: 12px;
	}
	/* 与页头 Logo 同款 */
	.footer__name {
		font-family: var(--font-heading);
		font-size: 1.5rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		color: #fff;
	}
	.footer__heading {
		margin-bottom: 16px !important;
		color: #fff;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.footer__list {
		display: grid;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.footer__bottom {
		margin-top: 56px;
		border-top: 1px solid #222;
		background: #111;
	}
	.footer__copy {
		padding-top: 14px;
		padding-bottom: 14px;
		font-size: 0.75rem;
		letter-spacing: 0.02em;
	}
</style>
