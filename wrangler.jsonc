{
	// 发布目标：Cloudflare Worker（纯静态资源，无脚本）
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "curly-sound-7f41",
	"compatibility_date": "2026-10-19",
	"assets": {
		"directory": "./dist",
		// 找不到页面时返回 dist/404.html，并带 404 状态码
		"not_found_handling": "404-page"
	},
	// 自定义域名：部署时自动创建 DNS 记录和证书
	"routes": [
		{ "pattern": "www.anlair.com", "custom_domain": true },
		{ "pattern": "anlair.com", "custom_domain": true }
	],
	// 保留 workers.dev 默认地址（国内打不开，仅海外调试用）
	"workers_dev": true
}
